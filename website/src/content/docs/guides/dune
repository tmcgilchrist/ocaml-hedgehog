(rule
 (alias generate-markdown)
 (enabled_if
  (= %{env:GENERATE_MARKDOWN=false} "true"))
 (mode
  (promote (until-clean)))
 (deps
  (:src %{workspace_root}/_doc/_markdown/hedgehog/getting-started.md)
  (:script %{workspace_root}/website/fix-odoc-md.sh))
 (targets getting-started.md)
 (action
  (progn
   (with-stdout-to
    %{targets}
    (progn
     (echo
      "---\ntitle: Getting Started\ndescription: Installation and first property\ndraft: false\nhead: []\n---\n\n")
     (cat %{src})))
   (run bash %{script} %{targets}))))

